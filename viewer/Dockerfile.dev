# syntax=docker/dockerfile:1
#
# Development image for the editor; see ../compose.yaml. It runs the Vite dev
# server, which serves the app with hot reload and proxies /api/scratchcad to
# the scratchcad service and /api/files to the MCP server. The checks run in
# it too:
#   docker compose run --rm viewer npm test

FROM node:24-slim

WORKDIR /app

# Install dependencies first so they are cached independently of our sources.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

EXPOSE 5173
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:5173/').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["npx", "vite", "--host", "0.0.0.0"]
