# syntax=docker/dockerfile:1
#
# Development image for the MCP server and editor; see ../compose.yaml. It
# runs `npm run dev`: MCP over streamable HTTP at /mcp (MCP clients on the
# host cannot reach a container's stdio) and the editor at /, with Node
# restarting on server changes and Vite hot-reloading the editor. The checks
# run in it too:
#   docker compose run --rm mcp npm test

FROM node:24-slim

WORKDIR /app
ENV SCRATCHCAD_MCP_TRANSPORT=http \
    SCRATCHCAD_MCP_HOST=0.0.0.0 \
    SCRATCHCAD_MCP_PORT=8000 \
    SCRATCHCAD_MCP_OUTPUT_DIR=/output

# Install dependencies first so they are cached independently of our sources.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

EXPOSE 8000
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8000/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["npm", "run", "dev"]
